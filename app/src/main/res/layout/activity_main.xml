<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:padding="32dp">

    <TextView
        android:id="@+id/setupTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/setup_title"
        android:textColor="@color/ink"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/setupBody"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/setupBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/setup_body"
        android:textColor="@color/slate"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/setupTitle"
        app:layout_constraintStart_toStartOf="@id/setupTitle"
        app:layout_constraintTop_toBottomOf="@id/setupTitle"
        app:layout_constraintBottom_toTopOf="@id/testLockButton" />

    <!-- Debug-only affordance for testing the lock screen before a backend
         exists to trigger it for real. Remove once real overdue/payment
         events drive this instead. -->
    <Button
        android:id="@+id/testLockButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Test: Show Lock Screen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/setupBody"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
