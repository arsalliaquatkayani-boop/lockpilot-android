<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:padding="32dp">

    <ImageView
        android:id="@+id/lockIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/lockpilot_logo"
        app:layout_constraintBottom_toTopOf="@id/lockTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/lockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/lock_title"
        android:textColor="@color/ink"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lockIcon" />

    <TextView
        android:id="@+id/lockBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/lock_body"
        android:textColor="@color/slate"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lockTitle"
        app:layout_constraintWidth_max="320dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/contactCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="@id/lockBody"
        app:layout_constraintStart_toStartOf="@id/lockBody"
        app:layout_constraintTop_toBottomOf="@id/lockBody">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/contactLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_contact_label"
                android:textColor="@color/slate"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/shopNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/shopContactText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/essentialAppsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="@string/lock_essential_apps_label"
        android:textColor="@color/slate"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/lockBody"
        app:layout_constraintStart_toStartOf="@id/lockBody"
        app:layout_constraintTop_toBottomOf="@id/contactCard" />

    <LinearLayout
        android:id="@+id/essentialAppsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/lockBody"
        app:layout_constraintStart_toStartOf="@id/lockBody"
        app:layout_constraintTop_toBottomOf="@id/essentialAppsLabel">

        <Button
            android:id="@+id/openPhoneButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/lock_open_phone" />

        <Button
            android:id="@+id/openMessagesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/lock_open_messages" />
    </LinearLayout>

    <TextView
        android:id="@+id/lockFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/lock_footer"
        android:textColor="@color/slate"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/lockBody"
        app:layout_constraintStart_toStartOf="@id/lockBody"
        app:layout_constraintTop_toBottomOf="@id/essentialAppsRow" />

</androidx.constraintlayout.widget.ConstraintLayout>
