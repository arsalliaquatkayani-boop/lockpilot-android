<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LockPilotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LockPilot"
        android:usesCleartextTraffic="false">

        <!-- Launcher / setup activity. Shop staff open this once during
             provisioning to confirm the device is linked to a customer
             record. Not shown again once the device is locked. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LockPilot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The unremovable lock screen shown when a device is overdue.
             singleTask + excludeFromRecents + lock task mode (pinned via
             DevicePolicyManager.setLockTaskPackages) keep the customer from
             navigating away from it while locked. -->
        <activity
            android:name=".LockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LockPilot.LockScreen" />

        <!-- The real home screen a customer sees every time they open this
             app once it's paired: their plan status, shop contact, and
             payment history. MainActivity redirects here once paired. -->
        <activity
            android:name=".CustomerHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.LockPilot" />

        <!-- Required receiver for Device Owner status. The app becomes
             Device Owner either via `adb shell dpm set-device-owner` during
             development, or via QR-code provisioning during the Android
             setup wizard in production — this receiver is what Android
             binds to either way. -->
        <receiver
            android:name=".LockPilotDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Instant "go check now" delivery — see LockPilotMessagingService
             and lockpilot-backend/supabase/functions/send-lock-push. A
             harmless no-op without google-services.json configured; the
             15-minute background check keeps working either way. -->
        <service
            android:name=".LockPilotMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
