## Copy this file to keystore.properties (same folder) and fill in your real
## values. keystore.properties is gitignored — it never gets committed, and
## Claude never reads it. Only you should know what's in it.

storeFile=lockpilot-release.jks
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyAlias=lockpilot
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
